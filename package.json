{
	"name": "obsidian-minote-importer",
	"version": "0.1.14",
	"description": "将小米云笔记单向导入 Obsidian，保存为 Markdown 文件。",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"svelte-check": "svelte-check --tsconfig tsconfig.json"
	},
	"keywords": [],
	"author": "lvtian-bot",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"esbuild-svelte": "^0.9.0",
		"obsidian": "latest",
		"svelte": "^5.16.1",
		"svelte-check": "^4.1.1",
		"svelte-preprocess": "^6.0.3",
		"tslib": "2.4.0",
		"typescript": "~5.0.0",
		"@types/ws": "^8.5.12"
	},
	"dependencies": {
		"@types/lodash.pickby": "^4.6.7",
		"lodash.pickby": "^4.6.0",
		"ws": "^8.18.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lvtian-bot/obsidian-minote-importer.git"
	},
	"homepage": "https://github.com/lvtian-bot/obsidian-minote-importer",
	"bugs": {
		"url": "https://github.com/lvtian-bot/obsidian-minote-importer/issues"
	},
	"private": true
}
